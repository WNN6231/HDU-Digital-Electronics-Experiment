`timescale 1ns/1ps
module tb_FivePeople;
  reg a,b,c,d,e;
  wire y;
  integer i;
  FivePeople dut(.a(a), .b(b), .c(c), .d(d), .e(e), .y(y));

  initial begin
    $dumpfile("FivePeople.vcd");
    $dumpvars(0, tb_FivePeople);

    for (i = 0; i < 32; i = i + 1) begin
      {a,b,c,d,e} = i[4:0]; // 00000 -> 11111
      #10;
    end
    #10 $finish;
  end
endmodule
