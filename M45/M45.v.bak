module Counter45 (
    input wire clk,
    input wire rst_n,
    output reg [7:0] q,
    output wire rco 
);


    parameter M = 45;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            q <= 8'b00000000;
        end
        else begin
            if (q == M - 1) begin 
                q <= 8'b00000000;
            end
            else begin
                q <= q + 1'b1;
            end
        end
    end

    assign rco = (q == M - 1) ? 1'b1 : 1'b0;

endmodule