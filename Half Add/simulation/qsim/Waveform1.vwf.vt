reg b1;
reg b2;
reg b3;
reg cin;
// wires                                               
wire Cout;
wire s0;
wire s1;
wire s2;
wire s3;

// assign statements (if any)                          
FourAdd i1 (
// port map - connection between master ports and signals/registers   
	.a0(a0),
	.a1(a1),
	.a2(a2),
	.a3(a3),
	.b0(b0),
	.b1(b1),
	.b2(b2),
	.b3(b3),
	.cin(cin),
	.Cout(Cout),
	.s0(s0),
	.s1(s1),
	.s2(s2),
	.s3(s3)
);
initial 
