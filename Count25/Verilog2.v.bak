`timescale 1ns/1ps

module Count25_Down_tb;
    reg clk;
    reg rst_n;
    wire [3:0] ten;
    wire [3:0] unit;


    Count25_Down uut (
        .clk(clk),
        .rst_n(rst_n),
        .ten(ten),
        .unit(unit)
    );


    always #10 clk = ~clk;

    initial begin
        clk = 0;
        rst_n = 0;
        #25 rst_n = 1;
        
        #1000;
        $stop;
    end
endmodule